# NexusTalent backend — no API key or GPU required
PORT=3001
HOST=127.0.0.1
# Blank uses the same-origin /api proxy (recommended).
VITE_API_URL=
# Optional separate backend for Vite development and preview:
# VITE_PROXY_TARGET=http://127.0.0.1:3001

# Public feed refreshes at startup and through POST /api/trends/refresh.
TREND_AUTO_REFRESH=true
# Comma-separated extra browser origins, for example https://your-demo.example
CORS_ORIGINS=
