{
  "name": "nexus-video-presentation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/export-html.mjs",
    "export:html": "node scripts/export-html.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 5186 --strictPort",
    "extract-narrations": "node scripts/extract-narrations.ts",
    "synthesize-audio": "bash scripts/synthesize-audio.sh"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.5",
    "typescript": "^5.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/node": "^22.0.0"
  }
}
