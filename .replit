# Optional Replit compatibility configuration. Deployment and proof of use are TBD.
entrypoint = "server/server.js"
modules = ["nodejs-22"]
run = "npm run dev"

[env]
HOST = "0.0.0.0"
PORT = "3001"

[deployment]
run = ["sh", "-c", "npm run build && npm start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173
