{
  "name": "nexustalent-360",
  "version": "1.0.0",
  "type": "module",
  "description": "NexusTalent 360: The National Tri-Party Green & AI Skills Synchronizer (XMUM SDC Hackathon 2026 - Domain 1: Aiversecity)",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "dev:full": "npm run dev",
    "client": "vite",
    "server": "node --watch server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/server.js",
    "test": "node --test tests/*.test.js",
    "test:backend": "node --test tests/*.test.js",
    "demo:backend": "node scripts/demo-backend.js",
    "test:integration": "node scripts/verify-integration.cjs",
    "test:workforce": "node scripts/verify-workforce.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "fflate": "^0.8.3",
    "lucide-react": "^0.469.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.5"
  },
  "license": "Apache-2.0",
  "overrides": {
    "postcss-selector-parser": "^7.1.7"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
